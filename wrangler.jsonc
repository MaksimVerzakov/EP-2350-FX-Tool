{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ep-2350-fx-tool",
  // Built by `npm run build` (scripts/build-worker.mjs from src/mcp/worker.ts).
  "main": "dist/_worker.js",
  "compatibility_date": "2025-03-01",
  // The web app is static assets; only /mcp runs the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*"]
  },
  // Workers Logs: keeps the Worker's console output (one JSON line per MCP message) for a few days.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Cloudflare Workers Builds: preview deployments for pull requests.
  "previews": {}
}
